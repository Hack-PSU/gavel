# Gavel environment
#
# Copy to .env and fill in. Nothing loads this file automatically: export it
# into your shell first (`set -a; . ./.env; set +a`) or pass it to a container
# with `docker run --env-file .env`. docker-compose.yml sets its own values for
# the local Postgres stack and only reads HACKPSU_API_KEY and HACKATHON_ID here.
#
# Production (Cloud Run) sets these on the service itself, with the database
# password and SECRET_KEY coming from Secret Manager.

# ------------------------------------------------------------------- database
#
# Production is MySQL on Cloud SQL (instance hackpsu-408118:us-east4:hackpsudb),
# shared with apiv3. Configure it in ONE of these ways; the first one set wins:
#
#   1. DATABASE_URL (or DB_URI), a full SQLAlchemy URL
#   2. the MYSQL_* parts below, which is how Cloud Run is configured: the
#      password lives in the one secret apiv3 also reads
#   3. nothing, which falls back to postgresql://localhost/gavel

# Option 1 -- a full URL. Examples:
#   Cloud SQL Auth Proxy on your machine (cloud-sql-proxy ... --port 3307):
#     DATABASE_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3307/gavel
#   Inside Cloud Run, over the mounted socket:
#     DATABASE_URL=mysql+pymysql://USER:PASSWORD@/gavel?unix_socket=/cloudsql/hackpsu-408118:us-east4:hackpsudb
#   The local docker-compose Postgres:
#     DATABASE_URL=postgresql://gavel:gavel_dev_password@localhost:5432/gavel
# Special characters in the password must be URL-encoded in this form.
# DATABASE_URL=

# Option 2 -- the parts (used only when DATABASE_URL and DB_URI are unset).
MYSQL_USER=gavel
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=gavel
# Through the Cloud SQL Auth Proxy, or any MySQL reachable over TCP:
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
# Or over a Unix socket instead of host/port (what Cloud Run uses):
# MYSQL_SOCKET_PATH=/cloudsql/hackpsu-408118:us-east4:hackpsudb

# Connection pool, per gunicorn worker. The instance allows 280 connections in
# total, shared with apiv3 -- see "Connection budget" in DEPLOY.md.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=2
# DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------- app

# Flask session signing key. Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Public URL of this Gavel deployment, used to build login/logout redirects.
GAVEL_URL=http://localhost:5001
PORT=5001
# DEBUG=true            # runserver.py only: Flask debug mode
PROXY=false             # true when behind a TLS-terminating proxy
# SERVER_NAME=

# gunicorn (production image only)
# WEB_CONCURRENCY=2
# WEB_THREADS=8
# WEB_TIMEOUT=120
# LOG_LEVEL=info

# ------------------------------------------------------------------- auth
#
# HackPSU Firebase session auth. The defaults point at a local auth service on
# port 3000 (the `auth` service in docker-compose.yml).
AUTH_SERVER_URL=https://auth.hackpsu.org/api/sessionUser
AUTH_LOGIN_URL=https://auth.hackpsu.org/login
AUTH_LOGOUT_URL=https://auth.hackpsu.org/api/sessionLogout
AUTH_ENVIRONMENT=production     # which Firebase custom claims to read: production or staging
MIN_JUDGE_ROLE=2                # Role.TEAM and above can judge
MIN_ADMIN_ROLE=4                # Role.TECH and above reach /admin

# How long a verified session is trusted before re-checking with the auth
# server. Judges poll /api/status every 5s, so this keeps that off the auth
# server without letting a revoked session linger.
AUTH_CACHE_TTL=60
AUTH_TIMEOUT=5

# ------------------------------------------------------------------- project sync

HACKPSU_API_URL=https://apiv3.hackpsu.org/judging/projects
# The active-hackathon endpoint; derived from HACKPSU_API_URL when unset.
# HACKPSU_HACKATHON_URL=https://apiv3.hackpsu.org/hackathons/active/static

# HackPSU API credential. Optional: the endpoints above are public. Set this
# only if they gain a @Roles decorator.
HACKPSU_API_KEY=

# Pin the active hackathon instead of asking the API. Useful locally, and for
# reopening a past event.
# HACKATHON_ID=

# Project sync is on-demand: a page load refreshes the list if the stored
# last_project_sync timestamp is older than this many seconds. No cron needed.
PROJECT_SYNC_INTERVAL=300
# LAZY_PROJECT_SYNC=false   # disable the on-demand refresh entirely
# ENABLE_PROJECT_SYNC=false # the in-process scheduler; needs an always-on instance

# Only sync projects in this category.
# CATEGORY_FILTER=
# Comma-separated categories to leave out of judging (case-insensitive). Their
# projects are not synced, and are deactivated if an earlier sync added them.
# CATEGORY_EXCLUDE=Business

# ------------------------------------------------------------------- judging

MIN_VIEWS=2
TIMEOUT=5.0             # minutes before a judge's assigned project is freed
# TIMER_DURATION=3      # minutes on the judging timer
# DEMO_DURATION_MINUTES=240

# ------------------------------------------------------------------- email
#
# Judge invitation emails. Celery delivers them through Redis.
DISABLE_EMAIL=true
# REDIS_URL=redis://localhost:6379/0
# EMAIL_FROM=noreply@hackpsu.org
# EMAIL_USER=
# EMAIL_PASSWORD=
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# USE_SENDGRID=false
# SENDGRID_API_KEY=

# ------------------------------------------------------------------- misc

SEND_STATS=false        # anonymous usage telemetry
# SCSS_FILTER=libsass

# migrate.py only: name the hackathon that pre-tenancy data is adopted into
# (migration 0003). Not needed for a database that is already migrated.
# LEGACY_HACKATHON_ID=
# LEGACY_HACKATHON_NAME=
