# HackPSU Firebase Authentication Configuration
# Copy this file to .env and fill in the values

# Environment for Firebase custom claims (production or staging)
AUTH_ENVIRONMENT=production

# Minimum role levels for access control
MIN_JUDGE_ROLE=2
MIN_ADMIN_ROLE=4

# Database configuration
DATABASE_URL=postgresql://localhost/gavel
DB_URI=postgresql://localhost/gavel

# Redis configuration (for Celery)
REDIS_URL=redis://localhost:6379/0
BROKER_URI=redis://localhost:6379/0

# Flask secret key (generate a random string)
SECRET_KEY=your-secret-key-here

# Email configuration (set DISABLE_EMAIL=true if not using email)
DISABLE_EMAIL=true
EMAIL_FROM=noreply@hackpsu.org
EMAIL_USER=your-email@hackpsu.org
EMAIL_PASSWORD=your-email-password

# Server configuration
PROXY=false
# SERVER_NAME=gavel.hackpsu.org  # Uncomment and set if needed

# Judging parameters
MIN_VIEWS=2
TIMEOUT=5.0

# HackPSU API credential. Optional: Gavel reads the active hackathon from
# /hackathons/active/static, which is public. Set this only if that endpoint
# gains a @Roles decorator, or to use /hackathons/active instead.
HACKPSU_API_KEY=

# Pin the active hackathon instead of asking the API. Useful locally, and for
# reopening a past event.
# HACKATHON_ID=

# How long a verified session is trusted before re-checking with the auth
# server. Judges poll /api/status every 5s, so this keeps that off the auth
# server without letting a revoked session linger.
AUTH_CACHE_TTL=60
AUTH_TIMEOUT=5

# SCSS compiler. The pinned pyScss (1.3.7) imports collections.Iterable and so
# cannot run on Python 3.10+; set this to `libsass` when developing on a modern
# Python. Production runs Python 3.9 and uses the default.
# SCSS_FILTER=pyscss

# Telemetry (optional - sends anonymous usage stats)
SEND_STATS=false
